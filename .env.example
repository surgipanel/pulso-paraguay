# Copiá este archivo a .env (nunca se sube al repositorio) o cargá las variables en el entorno.
# En GitHub Actions, la clave va como "secret" del repositorio: Settings → Secrets and variables → Actions.

# Clave de la API de Anthropic (Claude). Si falta, el sistema publica igual con resúmenes
# extractivos (sin IA), claramente marcados como tales en la web.
ANTHROPIC_API_KEY=

# Modelo de Claude a usar. Por defecto claude-opus-5-5. Alternativa barata: claude-haiku-4-5
PULSO_MODEL=claude-opus-5-5

# "auto" (usa IA si hay clave) | "off" (nunca usa IA, resúmenes extractivos)
PULSO_AI_MODE=auto

# Máximo de acontecimientos publicados por día (total entre ambas actualizaciones)
PULSO_MAX_EVENTS=20

# --- X (Twitter): publicación automática de 1 noticia por corrida ---
# Claves de la app en developer.x.com (OAuth 1.0a, permisos Read and Write). Sin ellas, se omite.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# none = sin enlace (US$ 0,015/post) · daily = el primer post del día con enlace · all = todos con enlace (US$ 0,20/post)
X_LINK_MODE=none
X_MAX_POSTS_PER_DAY=5
# Categorías que se publican en X (separadas por coma). Por defecto solo politica; "todas" para no filtrar.
X_CATEGORIES=politica
